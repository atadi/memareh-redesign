# Memareh environment variable template (placeholders only — do NOT commit real values)
#
# Copy to `.env.local` for local development and fill in real values.
# In Vercel, the Supabase integration already provides the modern variables for
# Production (see docs/VERCEL_DEPLOYMENT.md operator checklist). Ensure BOTH
# Production and Preview expose the modern names below.
#
# Integration-native contract (canonical):
#   BROWSER / PUBLIC ......... NEXT_PUBLIC_SUPABASE_URL
#                             NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   PRIVILEGED SERVER ........ SUPABASE_URL
#                             SUPABASE_SECRET_KEY
#
# Legacy manual variables (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
# are DEPRECATED and must not be used by application code. The 2026-08 incident
# originated from a privileged key being placed in the NEXT_PUBLIC_* anon variable.

# --- Public Supabase configuration (safe in browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Canonical site origin (used for metadata/canonical/OG/sitemap) ---
# Must be the PRODUCTION canonical origin, e.g. https://www.memareh.com
# Preview deployments should also set this to the production origin so Preview
# never publishes a Preview URL as the canonical SEO origin.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Privileged server configuration (NEVER exposed to the browser) ---
# Required at RUNTIME for admin server operations (e.g. /api/admin user listing).
# NOT required at BUILD time (sitemap + static article generation use the public
# publishable client). Keep it server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Optional runtime secret ---
# Used by /api/revalidate to authorize on-demand revalidation requests.
REVALIDATION_TOKEN=
