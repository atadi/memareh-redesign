# Memareh environment variable template (placeholders only — do NOT commit real values)
#
# Copy to `.env.local` for local development and fill in real values.
# In Vercel, set these in the project Environment Variables for BOTH
# Production and Preview (see docs/VERCEL_DEPLOYMENT.md operator checklist).

# --- Public Supabase configuration (safe in browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Canonical site origin (used for metadata/canonical/OG/sitemap) ---
# Must be the PRODUCTION canonical origin, e.g. https://www.memareh.com
# Preview deployments should also set this to the production origin so Preview
# never publishes a Preview URL as the canonical SEO origin.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Privileged server configuration (NEVER exposed to the browser) ---
# Required at RUNTIME for admin server operations (e.g. /api/admin user listing).
# NOT required at BUILD time after Phase A (sitemap + static article generation
# use the public/anon client). Keep it server-only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional runtime secret ---
# Used by /api/revalidate to authorize on-demand revalidation requests.
REVALIDATION_TOKEN=
