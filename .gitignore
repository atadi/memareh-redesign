# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw production audit snapshot (contains production identifiers/storage URLs — regenerable)
scripts/audit-public-articles.out.json

# backup artifacts / operational dumps (never commit; stored outside repo at C:/backups/...)
*.dump
*.backup
*.sql.bak
prod_map.json
local_map.json
public_articles_*.csv
public_articles_*.sql
memareh_*.dump
memareh_*.sql

# supabase CLI local link cache (generated, env-specific — not source)
supabase/.temp/

# bulk dry-run compiled optimizer (generated at runtime)
.article-optimizer-dist/
